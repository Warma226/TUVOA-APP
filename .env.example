# ─── Accès à l'application ───────────────────────────────────────────
# Mot de passe demandé à l'ouverture de l'app (identifiant : tuvoa)
APP_PASSWORD=
# Longue chaîne aléatoire : signe les liens des visuels générés
APP_SECRET=
# Adresse publique de l'app, sans / final (ex. https://tuvoa-app.vercel.app)
APP_URL=
# Clé appelée par la tâche planifiée (GitHub Actions) toutes les 15 min
CRON_SECRET=

# ─── IA (rédaction des posts) ────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ─── Base de données (Supabase) ─ sans elles, l'app tourne en mode démo
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Logo (optionnel) : image PNG de ton logo Coolvetica, hébergée en ligne
LOGO_URL=

# ─── WordPress ───────────────────────────────────────────────────────
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# ─── Facebook (Page) ─────────────────────────────────────────────────
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v21.0

# ─── LinkedIn (Page entreprise) ──────────────────────────────────────
LINKEDIN_TOKEN=
# urn:li:organization:123456
LINKEDIN_AUTHOR=
# Version d'API au format AAAAMM (à mettre à jour chaque année)
LINKEDIN_VERSION=202504

# ─── TikTok (après validation de l'application par TikTok) ───────────
TIKTOK_TOKEN=
